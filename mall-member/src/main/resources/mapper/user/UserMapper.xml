<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mall.user.mapper.UserMapper">

    <resultMap id="userResultMap" type="com.mall.user.model.UserEntity">
        <id property="id" column="id"/>
        <result property="username" column="username"/>
        <result property="passwordHash" column="password_hash"/>
        <result property="status" column="status"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <sql id="userColumns">
        id, username, password_hash, status, created_at, updated_at
    </sql>

    <select id="findByUsername" resultMap="userResultMap">
        SELECT <include refid="userColumns"/>
        FROM sys_user
        WHERE username = #{username}
        LIMIT 1
    </select>

    <select id="findById" resultMap="userResultMap">
        SELECT <include refid="userColumns"/>
        FROM sys_user
        WHERE id = #{id}
        LIMIT 1
    </select>

    <insert id="insert" parameterType="com.mall.user.model.UserEntity"
            useGeneratedKeys="true" keyProperty="id" keyColumn="id">
        INSERT INTO sys_user (username, password_hash, status)
        VALUES (#{username}, #{passwordHash}, #{status})
    </insert>

    <update id="updateAdminUser">
        UPDATE sys_user
        SET username = #{username}, status = #{status}
        WHERE id = #{id}
    </update>

    <update id="updateStatus">
        UPDATE sys_user SET status = #{status} WHERE id = #{id}
    </update>

    <update id="updatePassword">
        UPDATE sys_user SET password_hash = #{passwordHash} WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM sys_user WHERE id = #{id}
    </delete>

    <select id="countOrders" resultType="long">
        SELECT COUNT(*) FROM mall_order WHERE user_id = #{id}
    </select>

    <sql id="adminUserFilter">
        <where>
            <if test="keyword != null">username LIKE CONCAT('%', #{keyword}, '%')</if>
            <if test="status != null">AND status = #{status}</if>
        </where>
    </sql>

    <select id="countAdminPage" resultType="long">
        SELECT COUNT(*) FROM sys_user <include refid="adminUserFilter"/>
    </select>

    <select id="findAdminPage" resultType="com.mall.user.dto.AdminUserResponse">
        SELECT id, username, status, created_at, updated_at
        FROM sys_user
        <include refid="adminUserFilter"/>
        ORDER BY id DESC
        LIMIT #{offset}, #{size}
    </select>
</mapper>
