<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mall.banner.mapper.BannerMapper">

    <resultMap id="bannerResultMap" type="com.mall.banner.model.BannerEntity">
        <id property="id" column="id"/>
        <result property="title" column="title"/>
        <result property="imagePath" column="image_path"/>
        <result property="sortOrder" column="sort_order"/>
        <result property="status" column="status"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <select id="findEnabledHomeBanners" resultMap="bannerResultMap">
        SELECT id, title, image_path, sort_order, status, created_at, updated_at
        FROM home_banner
        WHERE status = 1
        ORDER BY sort_order ASC, id ASC
    </select>
</mapper>
