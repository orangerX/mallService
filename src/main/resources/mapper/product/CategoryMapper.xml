<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mall.product.mapper.CategoryMapper">

    <resultMap id="categoryResultMap" type="com.mall.product.model.CategoryEntity">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="code" column="code"/>
        <result property="sortOrder" column="sort_order"/>
        <result property="status" column="status"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <select id="findEnabledCategories" resultMap="categoryResultMap">
        SELECT id, name, code, sort_order, status, created_at, updated_at
        FROM product_category
        WHERE status = 1
        ORDER BY sort_order ASC, id ASC
    </select>
</mapper>
