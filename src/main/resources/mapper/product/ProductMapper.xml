<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mall.product.mapper.ProductMapper">

    <resultMap id="productResultMap" type="com.mall.product.model.ProductEntity">
        <id property="id" column="id"/>
        <result property="categoryId" column="category_id"/>
        <result property="name" column="name"/>
        <result property="subtitle" column="subtitle"/>
        <result property="imagePath" column="image_path"/>
        <result property="sortOrder" column="sort_order"/>
        <result property="status" column="status"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <select id="findOnShelfByCategoryId" resultMap="productResultMap">
        SELECT id, category_id, name, subtitle, image_path,
               sort_order, status, created_at, updated_at
        FROM mall_product
        WHERE category_id = #{categoryId}
          AND status = 1
        ORDER BY sort_order ASC, id ASC
    </select>

    <select id="findById" resultMap="productResultMap">
        SELECT id, category_id, name, subtitle, image_path,
               sort_order, status, created_at, updated_at
        FROM mall_product
        WHERE id = #{id}
    </select>
</mapper>
